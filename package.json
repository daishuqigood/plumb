{
  "name": "plumb",
  "version": "1.0.0",
  "description": "Personal local AI-native task management system",
  "private": true,
  "type": "module",
  "bin": {
    "plumb": "./bin/plumb.mjs"
  },
  "scripts": {
    "build": "tsc && cp lib/schema.sql dist/lib/schema.sql",
    "dev": "tsx cli/plumb.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "nanoid": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
